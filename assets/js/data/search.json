---
layout: compress
swcache: true
---
{% comment %}
  Overrides jekyll-theme-chirpy 7.5.0 assets/js/data/search.json.
  Only change vs upstream: the search index contains posts in the site's
  primary language only (LANG-FILTER). Re-check against the theme on upgrade.
{% endcomment %}
{% assign lang_default = site.lang_default | default: 'ko' %}
{% assign index_posts = site.posts | where_exp: 'item', 'item.lang == lang_default' %}
[
  {% for post in index_posts %}
  {
    "title": {{ post.title | jsonify }},
    "url": {{ post.url | relative_url | jsonify }},
    "categories": {{ post.categories | join: ', ' | jsonify }},
    "tags": {{ post.tags | join: ', ' | jsonify }},
    "date": {{ post.date | jsonify }},
    {% capture content -%}{% include post-summary.html full_text=true %}{%- endcapture -%}
    "content": {{ content | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
